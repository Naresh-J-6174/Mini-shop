NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/marketplace
JWT_SECRET=changeThisToARandomLongString

# AI assistant (buyer + seller chat) — Google Gemini's free tier, no credit card needed
# 1. Sign up at https://aistudio.google.com/app/apikey
# 2. Create an API key and paste it below
# Leave blank and the assistant will just tell users it isn't configured yet.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SuperCoins — fraction of a delivered order's total credited to the buyer as coins (1 coin = ₹1)
SUPERCOIN_EARN_RATE=0.02

# Product image uploads — Cloudinary's free tier, no credit card needed
# 1. Sign up at https://cloudinary.com
# 2. Dashboard shows Cloud Name, API Key and API Secret — paste them below
# Leave blank and sellers will see an "upload not configured" message instead of a file picker.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay TEST MODE checkout — no PAN/KYC needed for this.
# 1. Sign up free at https://dashboard.razorpay.com/signup (just email/phone, skip KYC)
# 2. Dashboard -> Settings -> API Keys -> Generate Test Key
# 3. Paste the Key Id and Key Secret below
# Leave blank and checkout falls back to the simple mock "Pay Now" button automatically.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
